# === Telegram Server Monitor Bot ===
# Скопируйте этот файл в `.env` и заполните значения.
# Файл `.env` не должен попадать в git (добавлен в .gitignore).

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Ключ Gemini API — нужен только если в config.json включён "enable_http_checks": true
GEMINI_API_KEY=
